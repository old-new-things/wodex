.DEFAULT_GOAL := all
.SUFFIXES:

ifeq ($(strip $(DEVKITPRO)),)
$(error Set DEVKITPRO or run scripts/build-switch.sh)
endif

PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
BUILD_DIR := $(PROJECT_ROOT)/build/switch
OUTPUT := $(BUILD_DIR)/wodex
APP_TITLE := Wodex
APP_AUTHOR := Wodex contributors
VERSION_FILE := $(PROJECT_ROOT)/VERSION
APP_VERSION := $(shell awk 'NR == 1 && length($$0) <= 15 && $$0 ~ /^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$$/ { version=$$0; next } { invalid=1 } END { if (NR == 1 && !invalid) print version }' "$(VERSION_FILE)")
ifeq ($(APP_VERSION),)
$(error VERSION must contain one stable X.Y.Z version of at most 15 characters)
endif
APP_ICON := $(PROJECT_ROOT)/assets/icon.jpg

include $(DEVKITPRO)/libnx/switch_rules

PKG_CONFIG := $(DEVKITPRO)/portlibs/switch/bin/aarch64-none-elf-pkg-config
PACKAGES := sdl2 SDL2_ttf libcurl
PKG_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PACKAGES))
PKG_LIBS := $(shell $(PKG_CONFIG) --static --libs $(PACKAGES))

RUST_LIB ?= $(PROJECT_ROOT)/target/aarch64-nintendo-switch-freestanding/release/libwodex_core.a
ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
CPPFLAGS := -D__SWITCH__ -DWODEX_VERSION='"$(APP_VERSION)"' \
  -I$(PROJECT_ROOT)/native/include \
  -I$(DEVKITPRO)/libnx/include $(PKG_CFLAGS)
CXXFLAGS := -std=c++17 -O2 -g -Wall -Wextra -ffunction-sections -fdata-sections \
  "-ffile-prefix-map=$(HOME)=/wodex/home" \
  "-ffile-prefix-map=$(PROJECT_ROOT)=/wodex/source" -pthread $(ARCH)
LDFLAGS := -specs=$(DEVKITPRO)/libnx/switch.specs $(ARCH) -pthread \
  -Wl,-Map,$(OUTPUT).map
LIBPATHS := -L$(DEVKITPRO)/libnx/lib -L$(DEVKITPRO)/portlibs/switch/lib
# Static libraries reference each other; resolve the entire group, then let
# libnx's specs supply startup, relocations and the homebrew executable layout.
LIBS := -Wl,--start-group $(RUST_LIB) $(PKG_LIBS) -lpthread -lnx -lc -lm -lstdc++ -Wl,--end-group
LD := $(CXX)
# Only platform adapters remain native; application/views/layout are Rust.
SOURCES := $(addprefix $(PROJECT_ROOT)/native/src/,main.cpp host.cpp render_backend.cpp platform.cpp fs_bindings.cpp http_bindings.cpp runtime_bindings.cpp home_menu_bindings.cpp)
OFILES := $(patsubst $(PROJECT_ROOT)/native/src/%.cpp,$(BUILD_DIR)/%.o,$(SOURCES))
REQUIRED_ROMFS_FILES := $(PROJECT_ROOT)/romfs/cacert.pem \
  $(PROJECT_ROOT)/romfs/fonts/NotoSansCJKsc-Regular.otf \
  $(PROJECT_ROOT)/romfs/fonts/OFL.txt \
  $(PROJECT_ROOT)/romfs/fonts/SourceCodePro-Regular.otf \
  $(PROJECT_ROOT)/romfs/fonts/SourceCodePro-OFL.txt \
  $(PROJECT_ROOT)/romfs/home-menu/template.bin \
  $(PROJECT_ROOT)/romfs/home-menu/manifest.json \
  $(PROJECT_ROOT)/romfs/home-menu/LICENSE.nx-hbloader.txt
# Files track content edits; directories also track nested additions/removals.
ROMFS_INPUTS := $(shell find "$(PROJECT_ROOT)/romfs" -print)
$(foreach resource,$(REQUIRED_ROMFS_FILES),$(if $(wildcard $(resource)),,$(error Missing required RomFS resource: $(resource))))
NROFLAGS := --nacp=$(OUTPUT).nacp --icon=$(APP_ICON) --romfsdir=$(PROJECT_ROOT)/romfs

.PHONY: all verify-home-menu
all: $(OUTPUT).nro

verify-home-menu:
	python3 "$(PROJECT_ROOT)/scripts/build-home-menu.py" --check

$(BUILD_DIR):
	mkdir -p "$@"

$(BUILD_DIR)/%.o: $(PROJECT_ROOT)/native/src/%.cpp $(PROJECT_ROOT)/scripts/Makefile.switch $(VERSION_FILE) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c "$<" -o "$@"

$(OUTPUT).elf: $(OFILES) $(RUST_LIB) $(PROJECT_ROOT)/scripts/Makefile.switch $(VERSION_FILE)
	$(LD) $(LDFLAGS) $(OFILES) $(LIBPATHS) $(LIBS) -o "$@"
	$(NM) -CSn "$@" > "$(OUTPUT).lst"
$(OUTPUT).nacp: $(VERSION_FILE) | $(BUILD_DIR)
$(OUTPUT).nro: $(OUTPUT).elf $(OUTPUT).nacp $(APP_ICON) $(REQUIRED_ROMFS_FILES) $(ROMFS_INPUTS) | verify-home-menu

-include $(OFILES:.o=.d)
